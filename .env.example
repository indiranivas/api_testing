# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///./telemetry.db

# For production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@host:5432/database_name

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Web Server Configuration
WEB_HOST=0.0.0.0
WEB_PORT=8001

# CORS Configuration - List of allowed origins
CORS_ORIGINS=["http://localhost:8001", "http://localhost:3000"]

# Debug Mode (true or false)
DEBUG=false

# Log Level (debug, info, warning, error)
LOG_LEVEL=info

# For Render deployment, these are auto-configured in render.yaml:
# - DATABASE_URL defaults to SQLite
# - PYTHONUNBUFFERED is set to 1
# - PORT is set by Render environment
